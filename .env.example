APP_NAME=Laporan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:7012
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — MySQL/MariaDB. Gunakan DB_PREFIX bila database dipakai bersama
# aplikasi lain agar tabel tidak bentrok. Migrations table mengikuti prefix.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laporan
DB_USERNAME=laporan
DB_PASSWORD=
DB_PREFIX=
DB_MIGRATIONS_TABLE=migrations

# Binary PHP 8.5 (dipakai ProcessExcelImport bila memanggil php dari dalam app)
PHP_BINARY=/usr/bin/php85

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Batas upload Excel
IMPORT_MAX_FILE_SIZE=10240
IMPORT_ALLOWED_TYPES=xlsx,xls
